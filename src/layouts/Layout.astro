---
import "@/styles/global.css";
import SplashHeader from "@/components/organisms/SplashHeader";
import SiteFooter from "@/components/organisms/SiteFooter.astro";
import PdfModalViewer from "@/components/organisms/PdfModalViewer";

const base = import.meta.env.BASE_URL;
const assetBase = base.endsWith("/") ? base : `${base}/`;
const site = Astro.site ?? new URL("https://ricardious.github.io");
const siteUrl = new URL(assetBase, site).toString();
const ogImageUrl = new URL(`${assetBase}og-image.png`, site).toString();
const title = "Portal de Laboratorios de Fisica | USAC";
const description =
  "Recursos de laboratorio, documentos academicos y manuales organizados para los cursos de Fisica de la Facultad de Ingenieria de la USAC.";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href={`${assetBase}favicon.svg`} />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Font Preloads -->
    <link
      rel="preload"
      href={`${assetBase}fonts/OpenSans-Light.ttf`}
      as="font"
      type="font/ttf"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href={`${assetBase}fonts/OpenSans-Bold.ttf`}
      as="font"
      type="font/ttf"
      crossorigin="anonymous"
    />

    <meta
      name="description"
      content={description}
    />
    <meta name="theme-color" content="#0f0f13" />

    <meta property="og:url" content={siteUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Vista previa del Portal de Laboratorios de Fisica de la USAC con acceso a recursos, documentos y manuales."
    />
    <meta property="og:locale" content="es_GT" />
    <meta property="og:site_name" content="Portal de Laboratorios de Fisica" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta
      name="twitter:image:alt"
      content="Vista previa del Portal de Laboratorios de Fisica de la USAC con acceso a recursos, documentos y manuales."
    />
  </head>
  <body class="min-h-screen bg-nebula text-white flex flex-col">
    <noscript>
      <div class="p-8 text-center text-gray-100 font-sans">
        <h1 class="text-2xl font-bold mb-4">¡Atención!</h1>
        <p class="text-lg">
          El <strong>Portal de Física - USAC</strong> requiere JavaScript para visualizar
          correctamente todos los elementos de la página.
        </p>
        <p class="mt-4">
          Por favor activa JavaScript en tu navegador para disfrutar de la mejor
          experiencia visual.
        </p>
      </div>
    </noscript>
    <SplashHeader client:load />
    <main class="w-full max-w-7xl mx-auto px-4 sm:px-6 md:px-8">
      <slot />
    </main>
    <PdfModalViewer client:load />
    <SiteFooter />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
  }
</style>
